    ls = p.s.rfind(b'\n', 0, min(off, p.n)) + 1
    col = off - ls + 1
    if off >= p.n:
        found = 'end of input'
    elif 0x20 <= p.s[off] < 0x7F:
        found = "'" + chr(p.s[off]) + "'"
    else:
        found = '\\x%02x' % p.s[off]
    raise ParseError('Parse error at line %d, column %d: expected %s, found %s' % (line, col, expected, found),
