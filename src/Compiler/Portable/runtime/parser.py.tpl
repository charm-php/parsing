        st = _call_rule(p, 0, 0)
    except _CommitFail as e:
        _fail(p, True, e.off, e.expected)
    except RecursionError:
        raise RecursionError('nesting too deep') from None
    finally:
        sys.setrecursionlimit(old)
    if st == MISS:
        _fail(p, False, max(p.off, p.maxoff), _join_expected(p, p.off, STR[GOAL_DESCRIPTION]))
    return None if st == HIT else p.v
