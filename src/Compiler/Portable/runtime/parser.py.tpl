    if m & (M_AND | M_NOT):
        return _pred(p, n)
    if not (m & (M_OPT | M_REP)):
        return _dir(p, n)
    if m & M_REP:
        return _rep(p, n, not (m & M_OPT))
    off = p.off
    r = _dir(p, n)
    if r != MISS:
        return r
    p.off = off
    p.v = None
    return VAL


