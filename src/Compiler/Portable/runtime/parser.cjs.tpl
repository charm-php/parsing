            p.off = off0;
            const st = body(p, r, minprec);
            if (st === MISS || p.off <= seed.end) break;
            seed.st = st; seed.v = p.v; seed.end = p.off;
        }
    } finally {
        p.depth--;
        p.seeds.splice(p.seeds.indexOf(seed), 1);
    }
    p.off = seed.end; p.v = seed.v;
    return seed.st;
}

function fail(p, committed, off, expected) {
    let line = 1, ls = 0;
    for (let i = 0; i < off && i < p.len; i++) if (p.s[i] === 10) { line++; ls = i + 1; }
    const col = off - ls + 1;
    let found;
    if (off >= p.len) found = 'end of input';
    else if (p.s[off] >= 0x20 && p.s[off] < 0x7F) found = "'" + String.fromCharCode(p.s[off]) + "'";
    else found = '\\x' + p.s[off].toString(16).padStart(2, '0');
    throw new ParseError(`Parse error at line ${line}, column ${col}: expected ${expected}, found ${found}`, committed, line, col, off, expected, found);
}

function parse(source) {
    const buf = typeof source === 'string' ? Buffer.from(source, 'utf8') : Buffer.from(source.buffer, source.byteOffset, source.byteLength);
    const p = { s: buf, buf, len: buf.length, off: 0, maxoff: -1, shield: -1, exp: [], quiet: 0, v: null, bt: [],
        regs: new Array(MAXREGS + 1).fill(0), seeds: [], depth: 0, ruleStart: 0, lcOff: 0, lcLs: 0, lcLine: 0 };
    let st;
    try {
        st = call_rule(p, 0, 0);
    } catch (e) {
        if (e instanceof CommitFail) fail(p, true, e.off, e.expected);
        if (e instanceof RangeError) throw new Error('nesting too deep');
        throw e;
    }
    if (st === MISS) fail(p, false, Math.max(p.off, p.maxoff), join_expected(p, p.off, STR[GOAL_DESCRIPTION]));
    return st === HIT ? null : p.v;
}

module.exports = { parse, ParseError };
