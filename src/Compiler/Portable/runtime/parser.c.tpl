/* arena */

static void *aalloc(P *p, size_t n) {
    arena *a = p->a;
    chunk *c = a->cur;
    n = (n + 7) & ~(size_t)7;
    if (c->used + n > c->cap) {
        chunk *nx = c->next;
        if (nx && nx->cap >= n) {
            nx->used = 0;
            c = nx;
        } else {
            size_t cap = n > 65536 ? n : 65536;
            chunk *nc = (chunk *)malloc(sizeof(chunk) + cap);
            if (!nc) { p->err = @N@_ERR_NOMEM; return NULL; }
            nc->cap = cap; nc->used = 0; nc->next = nx;
            c->next = nc;
            c = nc;
        }
        a->cur = c;
    }
    {
        void *r = (char *)(c + 1) + c->used;
        c->used += n;
        return r;
    }
}

static amark amk(P *p) { amark m; m.c = p->a->cur; m.used = m.c->used; return m; }
static void arew(P *p, amark m) { p->a->cur = m.c; m.c->used = m.used; }

/* value stack */

static int vpush(P *p, const char *key, size_t klen, value *v) {
    if (p->vsn == p->vscap) {
        size_t nc = p->vscap ? p->vscap * 2 : 64;
        ent *n = (ent *)realloc(p->vs, nc * sizeof(ent));
        if (!n) { p->err = @N@_ERR_NOMEM; return 0; }
        p->vs = n; p->vscap = nc;
    }
    p->vs[p->vsn].key = key; p->vs[p->vsn].klen = klen; p->vs[p->vsn].v = v;
    p->vsn++;
    return 1;
}

/* Collect vs[from..vsn) into a list, or a map if any entry has a label. */
static value *mklist(P *p, size_t from) {
    size_t n = p->vsn - from, i;
    int named = 0;
    long idx = 0;
    value *v = (value *)aalloc(p, sizeof(value));
    if (!v) return NULL;
    for (i = 0; i < n; i++) if (p->vs[from + i].key) { named = 1; break; }
    v->kind = named ? @N@_MAP : @N@_LIST;
    v->str = NULL; v->len = n; v->num = 0;
    v->items = n ? (value **)aalloc(p, n * sizeof(value *)) : NULL;
    v->keys = NULL;
    if (n && !v->items) return NULL;
    if (named) {
        v->keys = (@n@_key *)aalloc(p, n * sizeof(@n@_key));
        if (!v->keys) return NULL;
    }
    for (i = 0; i < n; i++) {
        ent *e = &p->vs[from + i];
        v->items[i] = e->v;
        if (named) {
            if (e->key) { v->keys[i].name = e->key; v->keys[i].name_len = e->klen; v->keys[i].index = 0; }
            else { v->keys[i].name = NULL; v->keys[i].name_len = 0; v->keys[i].index = idx++; }
        }
    }
    return v;
}

static value *mkstr(P *p, size_t off, size_t len) {
    value *v = (value *)aalloc(p, sizeof(value));
    if (!v) return NULL;
    v->kind = @N@_STRING; v->str = (const char *)p->s + off; v->len = len; v->items = NULL; v->keys = NULL; v->num = 0;
    return v;
}

static value *mknum(P *p, @n@_kind kind, long long n) {
    value *v = (value *)aalloc(p, sizeof(value));
    if (!v) return NULL;
    v->kind = kind; v->str = NULL; v->len = 0; v->items = NULL; v->keys = NULL; v->num = n;
    return v;
}

/* utf-8 */

static int u8dec(const unsigned char *s, size_t len, size_t pos, uint32_t *cp) {
    unsigned c = s[pos];
    size_t r = len - pos;
    if (c < 0x80) { *cp = c; return 1; }
    if (c >= 0xC2 && c <= 0xDF) {
        if (r < 2 || (s[pos + 1] & 0xC0) != 0x80) return 0;
        *cp = ((c & 0x1F) << 6) | (s[pos + 1] & 0x3F); return 2;
    }
    if (c >= 0xE0 && c <= 0xEF) {
        unsigned lo = c == 0xE0 ? 0xA0 : 0x80, hi = c == 0xED ? 0x9F : 0xBF;
        if (r < 3 || s[pos + 1] < lo || s[pos + 1] > hi || (s[pos + 2] & 0xC0) != 0x80) return 0;
        *cp = ((c & 0x0F) << 12) | ((s[pos + 1] & 0x3F) << 6) | (s[pos + 2] & 0x3F); return 3;
    }
    if (c >= 0xF0 && c <= 0xF4) {
        unsigned lo = c == 0xF0 ? 0x90 : 0x80, hi = c == 0xF4 ? 0x8F : 0xBF;
        if (r < 4 || s[pos + 1] < lo || s[pos + 1] > hi || (s[pos + 2] & 0xC0) != 0x80 || (s[pos + 3] & 0xC0) != 0x80) return 0;
        *cp = ((c & 0x07) << 18) | ((s[pos + 1] & 0x3F) << 12) | ((s[pos + 2] & 0x3F) << 6) | (s[pos + 3] & 0x3F); return 4;
    }
    return 0;
}

/* regex matcher: backtracking over the bytecode in RXCODE */

enum { RX_MATCH = 0, RX_BYTES = 1, RX_SET = 2, RX_SPLIT = 3, RX_JMP = 4, RX_ASSERT = 5, RX_LOOK = 6, RX_ATOMIC = 7,
       RX_SUBOK = 8, RX_REGSET = 9, RX_EMPTYJMP = 10, RX_REPSET = 11, RX_LOOKB = 12 };
enum { BT_ALT = 0, BT_REG = 1, BT_REPG = 2, BT_REPL = 3 };

static int inset(int set, uint32_t cp) {
    if (cp < 128) return (SET_BITS[set * 4 + (cp >> 5)] >> (cp & 31)) & 1;
    {
        int32_t lo = SET_INDEX[set * 2], n = SET_INDEX[set * 2 + 1], a = 0, b = n;
        while (a < b) {
            int32_t mid = (a + b) >> 1;
            if ((uint32_t)SET_RANGES[(lo + mid) * 2 + 1] < cp) a = mid + 1; else b = mid;
        }
        return a < n && (uint32_t)SET_RANGES[(lo + a) * 2] <= cp;
    }
}

static int matchone(P *p, int set, int64_t pos) {
    uint32_t cp; int l;
    if ((size_t)pos >= p->len) return 0;
    l = u8dec(p->s, p->len, (size_t)pos, &cp);
    return l && inset(set, cp) ? l : 0;
}

static int isword(P *p, int set, int64_t pos) {   /* is the character that starts at pos in the \w set */
    uint32_t cp;
    if ((size_t)pos >= p->len) return 0;
    return u8dec(p->s, p->len, (size_t)pos, &cp) && inset(set, cp);
}

static int btpush(P *p, int64_t a, int64_t b, int64_t c) {
    if (p->btn + 3 > p->btcap) {
        size_t nc = p->btcap ? p->btcap * 2 : 1024;
        int64_t *n = (int64_t *)realloc(p->bt, nc * sizeof(int64_t));
        if (!n) { p->err = @N@_ERR_NOMEM; return 0; }
        p->bt = n; p->btcap = nc;
    }
    p->bt[p->btn++] = a; p->bt[p->btn++] = b; p->bt[p->btn++] = c;
    return 1;
}

static int64_t prevchar(P *p, int64_t pos) {
    pos--;
    while (pos > 0 && (p->s[pos] & 0xC0) == 0x80) pos--;
    return pos;
}

/* Run the program at pc from pos. Returns the end offset of the first match or -1. With endreq >= 0 a
 * sub-program only succeeds if it ends exactly there (lookbehind). */
static int64_t rx_run(P *p, int64_t pc, int64_t pos, int64_t endreq) {
    const int32_t *c = RXCODE;
    size_t base = p->btn;
    int64_t r, q, mn, mx, e0, e1, e2, start;
    int n, i, l, set, mode, k, neg, ok;
    uint32_t cp;
    for (;;) {
        switch (c[pc]) {
        case RX_MATCH:
            p->btn = base; return pos;
        case RX_SUBOK:
            if (endreq >= 0 && pos != endreq) goto fail;
            p->btn = base; return pos;
        case RX_BYTES:
            n = c[pc + 1];
            if ((size_t)pos + (size_t)n > p->len) goto fail;
            for (i = 0; i < n; i++) if (p->s[pos + i] != (unsigned char)c[pc + 2 + i]) goto fail;
            pos += n; pc += 2 + n; break;
        case RX_SET:
            if ((size_t)pos >= p->len) goto fail;
            l = u8dec(p->s, p->len, (size_t)pos, &cp);
            if (!l || !inset(c[pc + 1], cp)) goto fail;
            pos += l; pc += 2; break;
        case RX_SPLIT:
            if (!btpush(p, BT_ALT | ((int64_t)c[pc + 2] << 8), pos, 0)) return -1;
            pc = c[pc + 1]; break;
        case RX_JMP:
            pc = c[pc + 1]; break;
        case RX_ASSERT:
            k = c[pc + 1];
            switch (k) {
            case 0: ok = pos == 0; break;
            case 1: ok = pos == 0 || p->s[pos - 1] == '\n'; break;
            case 2: ok = (size_t)pos == p->len || ((size_t)pos + 1 == p->len && p->s[pos] == '\n'); break;
            case 3: ok = (size_t)pos == p->len || p->s[pos] == '\n'; break;
            case 4: ok = (size_t)pos == p->len; break;
            default: {
                int a = pos > 0 && isword(p, c[pc + 2], prevchar(p, pos));
                int b = isword(p, c[pc + 2], pos);
                ok = k == 5 ? a != b : a == b;
            }
            }
            if (!ok) goto fail;
            pc += 3; break;
        case RX_LOOK:
            neg = c[pc + 1];
            r = rx_run(p, pc + 3, pos, -1);
            if (p->err) return -1;
            if ((r >= 0) == !neg) pc = c[pc + 2]; else goto fail;
            break;
        case RX_LOOKB:
            neg = c[pc + 1]; k = c[pc + 2];
            start = pos; ok = 1;
            for (i = 0; i < k; i++) { if (start == 0) { ok = 0; break; } start = prevchar(p, start); }
            r = ok ? rx_run(p, pc + 4, start, pos) : -1;
            if (p->err) return -1;
            if ((r >= 0) == !neg) pc = c[pc + 3]; else goto fail;
            break;
        case RX_ATOMIC:
            r = rx_run(p, pc + 2, pos, -1);
            if (p->err) return -1;
            if (r < 0) goto fail;
            pos = r; pc = c[pc + 1]; break;
        case RX_REGSET:
            if (!btpush(p, BT_REG | ((int64_t)c[pc + 1] << 8), p->regs[c[pc + 1]], 0)) return -1;
            p->regs[c[pc + 1]] = pos; pc += 2; break;
        case RX_EMPTYJMP:
            if (pos == p->regs[c[pc + 1]]) pc = c[pc + 2]; else pc += 3;
            break;
        case RX_REPSET:
            set = c[pc + 1]; mn = c[pc + 2]; mx = c[pc + 3]; mode = c[pc + 4];
            q = pos; r = 0;
            while (r < mn) { l = matchone(p, set, q); if (l <= 0) goto fail; q += l; r++; }
            if (mode == 1) {
                if ((mx < 0 || r < mx) && !btpush(p, BT_REPL | ((int64_t)pc << 8), q, r)) return -1;
            } else {
                int64_t minpos = q;
                while (mx < 0 || r < mx) { l = matchone(p, set, q); if (l <= 0) break; q += l; r++; }
                if (mode == 0 && q > minpos && !btpush(p, BT_REPG | ((int64_t)(pc + 5) << 8), q, minpos)) return -1;
            }
            pos = q; pc += 5; break;
        default:
            return -1;
        }
        continue;
    fail:
        for (;;) {
            if (p->btn == base) return -1;
            p->btn -= 3;
            e0 = p->bt[p->btn]; e1 = p->bt[p->btn + 1]; e2 = p->bt[p->btn + 2];
            switch ((int)(e0 & 255)) {
            case BT_ALT: pc = e0 >> 8; pos = e1; goto resume;
            case BT_REG: p->regs[e0 >> 8] = e1; break;
            case BT_REPG:
                q = prevchar(p, e1);
                if (q > e2 && !btpush(p, e0, q, e2)) return -1;
                pc = e0 >> 8; pos = q; goto resume;
            default: { /* BT_REPL */
                int64_t ipc = e0 >> 8;
                l = matchone(p, c[ipc + 1], e1);
                if (l <= 0) break;
                q = e1 + l; r = e2 + 1;
                if ((c[ipc + 3] < 0 || r < c[ipc + 3]) && !btpush(p, e0, q, r)) return -1;
                pc = ipc + 5; pos = q; goto resume;
            }
            }
        }
    resume:;
    }
}

static int64_t rx_match(P *p, int ri, size_t pos) {
    int64_t r;
    p->btn = 0;
    r = rx_run(p, RX_START[ri], (int64_t)pos, -1);
    p->btn = 0;
    return r;
}

/* parsing */

static int ev(P *p, int n, value **out);
static int call_rule(P *p, int r, long minprec, value **out);

static void add_exp(P *p, int64_t o, const char *what) {
    int i;
    if (o > p->maxoff) { p->maxoff = o; p->nexp = 1; p->exp[0] = what; }
    else if (o == p->maxoff) {
        for (i = 0; i < p->nexp; i++) if (strcmp(p->exp[i], what) == 0) return;
        if (p->nexp < MAXEXP) p->exp[p->nexp++] = what;
    }
}

/* a terminal (or a rule that could not start) failed here */
static int miss(P *p, const char *what) {
    if ((int64_t)p->off != p->shield && !p->quiet) add_exp(p, (int64_t)p->off, what);
    return MISS;
}

static int term_miss(P *p, int str) { return miss(p, STRP(str)); }

static void bump(P *p, size_t off) {
    if ((int64_t)off > p->maxoff) { p->maxoff = (int64_t)off; p->nexp = 0; }
}

/* what was expected at the failure, joined with " or ", or fallback if nothing is known for offset */
static void join_expected(P *p, size_t off, const char *fallback, char *buf, size_t cap) {
    int i;
    size_t n = 0;
    buf[0] = 0;
    if (p->nexp == 0 || p->maxoff < (int64_t)off) { snprintf(buf, cap, "%s", fallback); return; }
    for (i = 0; i < p->nexp; i++) {
        int w = snprintf(buf + n, cap - n, "%s%s", i ? " or " : "", p->exp[i]);
        if (w < 0 || (size_t)w >= cap - n) break;
        n += (size_t)w;
    }
}

/* a committed sequence failed: record the error; it propagates to the top as ERR */
static int commit_fail(P *p, int rule, size_t sp) {
    p->vsn = sp;
    p->cerr_off = (int64_t)p->off > p->maxoff ? p->off : (size_t)p->maxoff;
    join_expected(p, p->off, STRP(RULE(rule)[3]), p->cerr_expected, sizeof p->cerr_expected);
    return ERR;
}

/* add the value of element k to the sequence being collected in vs[sp..) */
static int item(P *p, int k, value *v, size_t sp) {
    const int32_t *kd = NODE(k);
    int mods = kd[1], name = kd[2];
    size_t i, j;
    if (name >= 0) {
        const char *key = STRP(name);
        size_t kl = STRL(name);
        int found = 0;
        for (i = sp; i < p->vsn; i++) {
            if (p->vs[i].key && p->vs[i].klen == kl && memcmp(p->vs[i].key, key, kl) == 0) { p->vs[i].v = v; found = 1; break; }
        }
        if (!found && !vpush(p, key, kl, v)) return 0;
    }
    if (mods & M_SPREAD) {
        int depth = (mods & M_SPREAD1) ? 1 : 2;
        if (v->kind == @N@_NULL) return 1;
        if (v->kind != @N@_LIST && v->kind != @N@_MAP) return vpush(p, NULL, 0, v);
        for (i = 0; i < v->len; i++) {
            value *it = v->items[i];
            if (depth > 1 && (it->kind == @N@_LIST || it->kind == @N@_MAP)) {
                for (j = 0; j < it->len; j++) if (!vpush(p, NULL, 0, it->items[j])) return 0;
            } else if (!vpush(p, NULL, 0, it)) return 0;
        }
        return 1;
    }
    if (name < 0 && !((kd[0] == OP_REF || kd[0] == OP_PREF) && kd[5])) return vpush(p, NULL, 0, v);
    return 1;
}

/* portable snippets: evaluate expression e; labels are looked up in the entries vs[sp0..lim) of the sequence */

static void linecol(P *p, size_t off, unsigned *line, unsigned *col) {
    size_t i = 0, ls = 0;
    unsigned ln = 1;
    if (p->lc_line && off >= p->lc_off) { i = p->lc_off; ls = p->lc_ls; ln = p->lc_line; }
    for (; i < off && i < p->len; i++) if (p->s[i] == '\n') { ln++; ls = i + 1; }
    p->lc_off = off; p->lc_ls = ls; p->lc_line = ln;
    *line = ln; *col = (unsigned)(off - ls + 1);
}

static value *eval_expr(P *p, int e, size_t sp0, size_t lim) {
    const int32_t *x = EXPRS + (size_t)e * 3;
    unsigned line, col;
    int i;
    switch (x[0]) {
    case E_TRUE: return (value *)&TRUEV;
    case E_FALSE: return (value *)&FALSEV;
    case E_INT: return mknum(p, @N@_INT, x[1]);
    case E_STR: {
        value *v = mknum(p, @N@_STRING, 0);
        if (v) { v->str = STRP(x[1]); v->len = STRL(x[1]); }
        return v;
    }
    case E_LABEL: {
        const char *key = STRP(x[1]);
        size_t kl = STRL(x[1]), j;
        for (j = sp0; j < lim; j++)
            if (p->vs[j].key && p->vs[j].klen == kl && memcmp(p->vs[j].key, key, kl) == 0) return p->vs[j].v;
        return (value *)&NULLV;
    }
    case E_OFFSET: return mknum(p, @N@_INT, (long long)p->rule_start);
    case E_LINE: linecol(p, p->rule_start, &line, &col); return mknum(p, @N@_INT, line);
    case E_COLUMN: linecol(p, p->rule_start, &line, &col); return mknum(p, @N@_INT, col);
    case E_COALESCE: {
        value *v = eval_expr(p, x[1], sp0, lim);
        if (!v || v->kind != @N@_NULL) return v;
        return eval_expr(p, x[2], sp0, lim);
    }
    case E_LIST: {
        size_t from = p->vsn;
        value *l;
        for (i = 0; i < x[2]; i++) {
            const int32_t *kv = EKIDS + ((size_t)x[1] + (size_t)i) * 2;
            value *v = eval_expr(p, kv[1], sp0, lim);
            if (!v) { p->vsn = from; return NULL; }
            if (!vpush(p, kv[0] >= 0 ? STRP(kv[0]) : NULL, kv[0] >= 0 ? STRL(kv[0]) : 0, v)) return NULL;
        }
        l = mklist(p, from);
        p->vsn = from;
        return l;
    }
    default: return (value *)&NULLV;
    }
}

static int seq(P *p, int n, value **out) {
    const int32_t *nd = NODE(n);
    int a = nd[3], cnt = nd[4], flags = nd[5] & 255, rule = nd[5] >> 8, i, k, r, committed = 0;
    size_t off0 = p->off, sp0 = p->vsn;
    amark m = amk(p);
    value *v;
    for (i = 0; i < cnt; i++) {
        k = KIDS[a + i];
        if (NODE(k)[0] == OP_COMMIT) { committed = 1; continue; }
        if (NODE(k)[0] == OP_SNIP) {   /* a portable snippet ends the sequence: its value is the value */
            v = eval_expr(p, NODE(k)[3], sp0, p->vsn);
            p->vsn = sp0;
            if (!v) return ERR;
            *out = v;
            return VAL;
        }
        r = ev(p, k, &v);
        if (r == ERR) { p->vsn = sp0; return ERR; }
        if (r == MISS) {
            if (flags & SEQ_BUMP) bump(p, off0);
            if (committed) return commit_fail(p, rule, sp0);
            p->off = off0; p->vsn = sp0; arew(p, m);
            return MISS;
        }
        if (r == HIT) continue;
        if (!item(p, k, v, sp0)) { p->vsn = sp0; return ERR; }
    }
    if (p->vsn == sp0) return HIT;
    if (flags & SEQ_COLLAPSE) { *out = p->vs[sp0].v; p->vsn = sp0; return VAL; }
    v = mklist(p, sp0);
    p->vsn = sp0;
    if (!v) return ERR;
    *out = v;
    return VAL;
}

/* one operator alternative of a Pratt rule, with the left operand already parsed */
static int pratt_op(P *p, int n, value *left, value **out) {
    const int32_t *nd = NODE(n);
    int a = nd[3], cnt = nd[4], rule = nd[5] >> 8, i, k, r, committed = 0;
    size_t off0 = p->off, sp0 = p->vsn;
    value *v;
    if (!item(p, KIDS[a], left, sp0)) { p->vsn = sp0; return ERR; }
    for (i = 1; i < cnt; i++) {
        k = KIDS[a + i];
        if (NODE(k)[0] == OP_COMMIT) { committed = 1; continue; }
        if (NODE(k)[0] == OP_SNIP) {
            v = eval_expr(p, NODE(k)[3], sp0, p->vsn);
            p->vsn = sp0;
            if (!v) return ERR;
            *out = v;
            return VAL;
        }
        r = ev(p, k, &v);
        if (r == ERR) { p->vsn = sp0; return ERR; }
        if (r == MISS) {
            if (committed) return commit_fail(p, rule, sp0);
            p->off = off0; p->vsn = sp0;
            return MISS;
        }
        if (r == HIT) continue;
        if (!item(p, k, v, sp0)) { p->vsn = sp0; return ERR; }
    }
    v = mklist(p, sp0);
    p->vsn = sp0;
    if (!v) return ERR;
    *out = v;
    return VAL;
}

static int choice(P *p, int n, value **out) {
    const int32_t *nd = NODE(n);
    int a = nd[3], cnt = nd[4], i, r;
    size_t off0 = p->off;
    for (i = 0; i < cnt; i++) {
        p->off = off0;
        r = ev(p, KIDS[a + i], out);
        if (r != MISS) return r;
    }
    if (nd[5] & CH_BUMP) bump(p, off0);
    p->off = off0;
    return MISS;
}

static int dir(P *p, int n, value **out) {
    const int32_t *nd = NODE(n);
    switch (nd[0]) {
    case OP_TEXT: {
        size_t len = STRL(nd[3]), i;
        const char *t = STRP(nd[3]);
        if (p->off + len <= p->len) {
            if (nd[4]) {
                for (i = 0; i < len; i++) {
                    unsigned char ch = p->s[p->off + i];
                    if (ch >= 'A' && ch <= 'Z') ch = (unsigned char)(ch + 32);
                    if (ch != (unsigned char)t[i]) break;
                }
            } else {
                for (i = 0; i < len; i++) if (p->s[p->off + i] != (unsigned char)t[i]) break;
            }
            if (i == len) {
                value *v = mkstr(p, p->off, len);
                if (!v) return ERR;
                p->off += len; *out = v; return VAL;
            }
        }
        return term_miss(p, nd[5]);
    }
    case OP_REGEX: {
        int64_t e = rx_match(p, nd[3], p->off);
        if (p->err) return ERR;
        if (e >= 0) {
            value *v = mkstr(p, p->off, (size_t)e - p->off);
            if (!v) return ERR;
            p->off = (size_t)e; *out = v; return VAL;
        }
        return term_miss(p, nd[5]);
    }
    case OP_ANY: {
        uint32_t cp; int l;
        if (p->off < p->len) {
            value *v;
            l = u8dec(p->s, p->len, p->off, &cp);
            if (!l) l = 1;
            v = mkstr(p, p->off, (size_t)l);
            if (!v) return ERR;
            p->off += (size_t)l; *out = v; return VAL;
        }
        return term_miss(p, nd[5]);
    }
    case OP_SOF:
        if (p->off == 0) return HIT;
        return term_miss(p, nd[5]);
    case OP_EOF:
        if (p->off == p->len) return HIT;
        return miss(p, "end of input");
    case OP_NOTHING: case OP_COMMIT:
        return HIT;
    case OP_REF: {
        if (nd[4] >= 0) {
            const unsigned char *g = GUARDS + (size_t)nd[4] * 32;
            if (p->off >= p->len || !((g[p->s[p->off] >> 3] >> (p->s[p->off] & 7)) & 1)) {
                return miss(p, STRP(RULE(nd[3])[11]));
            }
        }
        return call_rule(p, nd[3], 0, out);
    }
    case OP_PREF:
        return call_rule(p, nd[3], nd[4], out);
    case OP_SEQ:
        return seq(p, n, out);
    case OP_CHOICE:
        return choice(p, n, out);
    }
    return MISS;
}

static int pred(P *p, int n, value **out) {
    const int32_t *nd = NODE(n);
    size_t off = p->off, sp = p->vsn;
    int quiet = nd[0] <= OP_COMMIT, r, matched;
    amark m = amk(p);
    p->quiet += quiet;   /* a predicate on a terminal never becomes an error position */
    r = dir(p, n, out);
    p->quiet -= quiet;
    if (r == ERR) {
        if (p->err) return ERR;
        r = MISS;                 /* a committed failure inside a predicate only means "did not match" */
    }
    p->off = off; p->vsn = sp; arew(p, m);
    matched = r != MISS;
    if (nd[1] & M_NOT) return matched ? MISS : HIT;
    return matched ? HIT : MISS;
}

static int rep(P *p, int n, int atleast, value **out) {
    const int32_t *nd = NODE(n);
    size_t sp0 = p->vsn, start;
    int quiet = nd[0] <= OP_COMMIT, r;
    long count = 0;
    amark m = amk(p);
    value *v = NULL;
    p->quiet += quiet;   /* the attempt that ends a repetition of a terminal is not an error position */
    for (;;) {
        start = p->off;
        r = dir(p, n, &v);
        if (r == ERR) { p->quiet -= quiet; p->vsn = sp0; return ERR; }
        if (r == MISS) break;
        if (p->off == start) {
            if (atleast && count == 0) { count++; if (r != HIT && !vpush(p, NULL, 0, v)) { p->quiet -= quiet; return ERR; } }
            break;
        }
        count++;
        if (r != HIT && !vpush(p, NULL, 0, v)) { p->quiet -= quiet; return ERR; }
    }
    p->quiet -= quiet;
    if (atleast && count == 0) {
        if (quiet) dir(p, n, &v);   /* a `+` that cannot match once reports the failure */
        p->vsn = sp0; arew(p, m); return MISS;
    }
    v = mklist(p, sp0);
    p->vsn = sp0;
    if (!v) return ERR;
    *out = v;
    return VAL;
}

static int ev(P *p, int n, value **out) {
    const int32_t *nd = NODE(n);
    int mods = nd[1], r;
    if (mods & (M_AND | M_NOT)) return pred(p, n, out);
    if (!(mods & (M_OPT | M_REP))) return dir(p, n, out);
    if (mods & M_REP) return rep(p, n, !(mods & M_OPT), out);
    {
        size_t off = p->off, sp = p->vsn;
        amark m = amk(p);
        r = dir(p, n, out);
        if (r != MISS) return r;
        p->off = off; p->vsn = sp; arew(p, m);
        *out = (value *)&NULLV;
        return VAL;
    }
}

static int pratt0(P *p, int r, long minprec, value **out) {
    const int32_t *rr = RULE(r);
    int pstart = rr[7], pcnt = rr[8], ostart = rr[9], ocnt = rr[10], i, st, lst, res;
    size_t off0, offp = p->off;
    value *left = NULL, *prev, *nv = NULL;
    int prevst;
    st = MISS;
    for (i = 0; i < pcnt; i++) {
        if (i > 0) p->off = offp;
        st = ev(p, PALTS[(pstart + i) * 3], &left);
        if (st != MISS) break;
    }
    if (st == ERR) return ERR;
    if (st == MISS) { p->off = offp; return MISS; }
    lst = st;
    if (lst == HIT) left = (value *)&NULLV;
    for (;;) {
        int matched = 0;
        off0 = p->off;
        prev = left; prevst = lst;
        for (i = 0; i < ocnt; i++) {
            const int32_t *pa = PALTS + (size_t)(ostart + i) * 3;
            if (minprec < pa[1]) {
                res = pratt_op(p, pa[0], left, &nv);
                if (res == ERR) return ERR;
                if (res == VAL) { matched = 1; left = nv; lst = VAL; }
            }
            if (matched) break;
        }
        if (!matched) break;
        if (p->off > off0) continue;
        left = prev; lst = prevst;
        break;
    }
    if (lst == HIT) return HIT;
    *out = left;
    return VAL;
}

static int body(P *p, int r, long minprec, value **out) {
    const int32_t *rr = RULE(r);
    int st;
    int64_t shield = p->shield;
    if (rr[5]) {   /* a described rule: its description is expected here and stands for what its terminals expect here */
        add_exp(p, (int64_t)p->off, STRP(rr[11]));
        p->shield = (int64_t)p->off;
    }
    st = (rr[1] & 1) ? pratt0(p, r, minprec, out) : ev(p, rr[0], out);
    p->shield = shield;
    return st;
}

static int call_rule0(P *p, int r, long minprec, value **out) {
    const int32_t *rr = RULE(r);
    int st;
    size_t off0, si;
    long key = (rr[1] & 1) ? minprec : -1;
    if (p->depth >= @N@_MAX_DEPTH) { p->err = @N@_ERR_DEPTH; return ERR; }
    if (!rr[2]) {
        p->depth++;
        st = body(p, r, minprec, out);
        p->depth--;
        return st;
    }
    off0 = p->off;
    for (si = p->seedn; si > 0; si--) {
        seed *s = &p->seeds[si - 1];
        if (s->rule == r && s->off == off0 && s->minprec == key) {
            p->off = s->end; *out = s->v; return s->st;
        }
    }
    if (p->seedn == p->seedcap) {
        size_t nc = p->seedcap ? p->seedcap * 2 : 16;
        seed *n = (seed *)realloc(p->seeds, nc * sizeof(seed));
        if (!n) { p->err = @N@_ERR_NOMEM; return ERR; }
        p->seeds = n; p->seedcap = nc;
    }
    si = p->seedn++;
    p->seeds[si].rule = r; p->seeds[si].off = off0; p->seeds[si].minprec = key;
    p->seeds[si].st = MISS; p->seeds[si].v = NULL; p->seeds[si].end = off0;
    p->depth++;
    for (;;) {
        value *v = NULL;
        p->off = off0;
        st = body(p, r, minprec, &v);
        if (st == ERR) { p->depth--; p->seedn = si; return ERR; }
        if (st == MISS || p->off <= p->seeds[si].end) break;
        p->seeds[si].st = st; p->seeds[si].v = v; p->seeds[si].end = p->off;
    }
    p->depth--;
    p->off = p->seeds[si].end; st = p->seeds[si].st; *out = p->seeds[si].v;
    p->seedn = si;
    return st;
}

static int call_rule(P *p, int r, long minprec, value **out) {
    size_t saved = p->rule_start;
    int st;
    p->rule_start = p->off;
    st = call_rule0(p, r, minprec, out);
    p->rule_start = saved;
    return st;
}

/* public API */

static void set_error(P *p, @n@_error *err, int kind, int committed, size_t off, const char *expected) {
    size_t i, ls = 0;
    unsigned line = 1;
    if (!err) return;
    memset(err, 0, sizeof *err);
    err->kind = kind;
    if (kind != @N@_ERR_PARSE) {
        snprintf(err->message, sizeof err->message, kind == @N@_ERR_NOMEM ? "out of memory" : "nesting too deep");
        err->expected[0] = 0; err->found[0] = 0;
        return;
    }
    for (i = 0; i < off && i < p->len; i++) if (p->s[i] == '\n') { line++; ls = i + 1; }
    err->committed = committed; err->offset = off; err->line = line; err->column = (unsigned)(off - ls + 1);
    snprintf(err->expected, sizeof err->expected, "%s", expected);
    if (off >= p->len) snprintf(err->found, sizeof err->found, "end of input");
    else if (p->s[off] >= 0x20 && p->s[off] < 0x7F) snprintf(err->found, sizeof err->found, "'%c'", p->s[off]);
    else snprintf(err->found, sizeof err->found, "\\x%02x", p->s[off]);
    snprintf(err->message, sizeof err->message, "Parse error at line %u, column %u: expected %s, found %s",
             err->line, err->column, expected, err->found);
}

@n@_result *@n@_parse(const char *src, size_t len, @n@_error *err) {
    P p;
    @n@_result *res;
    chunk *c;
    value *v = NULL;
    int st;
    memset(&p, 0, sizeof p);
    res = (@n@_result *)calloc(1, sizeof *res);
    c = (chunk *)malloc(sizeof(chunk) + 65536);
    if (!res || !c) { free(res); free(c); set_error(&p, err, @N@_ERR_NOMEM, 0, 0, NULL); return NULL; }
    c->next = NULL; c->cap = 65536; c->used = 0;
    res->a.head = res->a.cur = c;
    p.a = &res->a;
    p.s = (const unsigned char *)(src ? src : "");
    p.len = len;
    p.maxoff = -1; p.shield = -1;
    st = call_rule(&p, 0, 0, &v);
    if (st == MISS || st == ERR) {
        if (p.err) set_error(&p, err, p.err, 0, 0, NULL);
        else if (st == ERR) set_error(&p, err, @N@_ERR_PARSE, 1, p.cerr_off, p.cerr_expected);
        else {
            char ex[256];
            size_t off = (int64_t)p.off > p.maxoff ? p.off : (size_t)p.maxoff;
            join_expected(&p, p.off, STRP(GOAL_DESCRIPTION), ex, sizeof ex);
            set_error(&p, err, @N@_ERR_PARSE, 0, off, ex);
        }
        res->root = NULL;
        @n@_result_free(res);
        free(p.vs); free(p.bt); free(p.seeds);
        return NULL;
    }
    res->root = st == HIT ? (value *)&NULLV : v;
    free(p.vs); free(p.bt); free(p.seeds);
    return res;
}

const @n@_value *@n@_result_value(const @n@_result *r) { return r && r->root ? r->root : &NULLV; }

void @n@_result_free(@n@_result *r) {
    chunk *c, *n;
    if (!r) return;
    for (c = r->a.head; c; c = n) { n = c->next; free(c); }
    free(r);
}

const @n@_value *@n@_get(const @n@_value *m, const char *label) {
    size_t i, l = strlen(label);
    if (!m || m->kind != @N@_MAP) return NULL;
    for (i = 0; i < m->len; i++)
        if (m->keys[i].name && m->keys[i].name_len == l && memcmp(m->keys[i].name, label, l) == 0) return m->items[i];
    return NULL;
}

typedef struct { char *buf; size_t cap, n; } sink;

static void sput(sink *s, const char *t, size_t l) {
    if (s->n < s->cap) {
        size_t room = s->cap - s->n;
        memcpy(s->buf + s->n, t, l < room ? l : room);
    }
    s->n += l;
}

static void sstr(sink *s, const char *t, size_t l) {
    size_t i;
    sput(s, "\"", 1);
    for (i = 0; i < l; i++) {
        unsigned char ch = (unsigned char)t[i];
        char tmp[8];
        if (ch == '"') sput(s, "\\\"", 2);
        else if (ch == '\\') sput(s, "\\\\", 2);
        else if (ch == '\n') sput(s, "\\n", 2);
        else if (ch == '\r') sput(s, "\\r", 2);
        else if (ch == '\t') sput(s, "\\t", 2);
        else if (ch < 0x20) { snprintf(tmp, sizeof tmp, "\\u%04x", ch); sput(s, tmp, 6); }
        else sput(s, t + i, 1);
    }
    sput(s, "\"", 1);
}

static void sval(sink *s, const @n@_value *v) {
    size_t i;
    char tmp[32];
    switch (v->kind) {
    case @N@_NULL: sput(s, "null", 4); break;
    case @N@_INT: { int l = snprintf(tmp, sizeof tmp, "%lld", v->num); sput(s, tmp, (size_t)l); break; }
    case @N@_BOOL: if (v->num) sput(s, "true", 4); else sput(s, "false", 5); break;
    case @N@_STRING: sstr(s, v->str, v->len); break;
    case @N@_LIST:
        sput(s, "[", 1);
        for (i = 0; i < v->len; i++) { if (i) sput(s, ",", 1); sval(s, v->items[i]); }
        sput(s, "]", 1);
        break;
    case @N@_MAP:
        sput(s, "{", 1);
        for (i = 0; i < v->len; i++) {
            if (i) sput(s, ",", 1);
            if (v->keys[i].name) sstr(s, v->keys[i].name, v->keys[i].name_len);
            else { int l = snprintf(tmp, sizeof tmp, "\"%ld\"", v->keys[i].index); sput(s, tmp, (size_t)l); }
            sput(s, ":", 1);
            sval(s, v->items[i]);
        }
        sput(s, "}", 1);
        break;
    }
}

size_t @n@_to_json(const @n@_value *v, char *buf, size_t cap) {
    sink s;
    s.buf = buf; s.cap = cap ? cap - 1 : 0; s.n = 0;
    sval(&s, v);
    if (cap) buf[s.n < s.cap ? s.n : s.cap] = 0;
    return s.n;
}
