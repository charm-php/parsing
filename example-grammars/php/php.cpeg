    = ClassNameOrVar T_PAAMAYIM_NEKUDOTAYIM IdentifierMaybeReserved  <?  return new Expr\ClassConstFetch($_0, $_2);  ?>
    | ClassNameOrVar T_PAAMAYIM_NEKUDOTAYIM "{" Expr "}"  <?  return new Expr\ClassConstFetch($_0, $_3);  ?>
    | ClassNameOrVar T_PAAMAYIM_NEKUDOTAYIM Error  <?  return new Expr\ClassConstFetch($_0, new Expr\Error($this->attributes()));  ?>

# array_short_syntax
ArrayShortSyntax
    = "[" ArrayPairList "]"  <?  return new Expr\Array_($_1, $attrs);  ?>

# dereferenceable_scalar
DereferenceableScalar
    = T_ARRAY "(" ArrayPairList ")"  <?  return new Expr\Array_($_2, $attrs);  ?>
    | T_CONSTANT_ENCAPSED_STRING  <?  return Scalar\String_::fromString($_0, $this->attributes(), true);  ?>
    | "\"" EncapsList "\""  <?  return new Scalar\InterpolatedString($_1, $attrs);  ?>
    | ArrayShortSyntax  <?  return $_0;  ?>

# scalar
Scalar
    = T_LNUMBER  <?  return $this->parseLNumber($_0, $this->attributes(), false);  ?>
    | T_DNUMBER  <?  return Scalar\Float_::fromString($_0, $this->attributes());  ?>
    | T_START_HEREDOC T_ENCAPSED_AND_WHITESPACE T_END_HEREDOC  <?  return $this->parseDocString($_0, $_1, $_2, $this->attributes(), $this->attributes(), true);  ?>
    | T_START_HEREDOC T_END_HEREDOC  <?  return $this->parseDocString($_0, '', $_1, $this->attributes(), $this->attributes(), true);  ?>
    | T_START_HEREDOC EncapsList T_END_HEREDOC  <?  return $this->parseDocString($_0, $_1, $_2, $this->attributes(), $this->attributes(), true);  ?>
    | DereferenceableScalar
    | Constant
    | ClassConstant

# optional_expr
OptionalExpr
    = Expr
    | ""  <?  return null;  ?>

# fully_dereferenceable
FullyDereferenceable
    = "(" Expr ")"  <?  return $_1;  ?>
    | DereferenceableScalar
    | ClassConstant
    | NewDereferenceable
    | Variable

# array_object_dereferenceable
ArrayObjectDereferenceable
    = Constant
    | FullyDereferenceable

# callable_expr
CallableExpr
    = "(" Expr ")"  <?  return $_1;  ?>
    | DereferenceableScalar
    | NewDereferenceable
    | CallableVariable

# callable_variable
CallableVariable
    = SimpleVariable
    | FunctionCall
    | ArrayObjectDereferenceable "[" OptionalExpr "]"  <?  return new Expr\ArrayDimFetch($_0, $_2);  ?>
    | ArrayObjectDereferenceable "{" Expr "}"  <?  return new Expr\ArrayDimFetch($_0, $_2);  ?>
    | ArrayObjectDereferenceable T_OBJECT_OPERATOR PropertyName ArgumentList  <?  return new Expr\MethodCall($_0, $_2, $_3);  ?>
    | ArrayObjectDereferenceable T_NULLSAFE_OBJECT_OPERATOR PropertyName ArgumentList  <?  return new Expr\NullsafeMethodCall($_0, $_2, $_3);  ?>

# optional_plain_variable
OptionalPlainVariable
    = PlainVariable
    | ""  <?  return null;  ?>

# variable
Variable
    = StaticMember
    | CallableVariable
    | ArrayObjectDereferenceable T_OBJECT_OPERATOR PropertyName  <?  return new Expr\PropertyFetch($_0, $_2);  ?>
    | ArrayObjectDereferenceable T_NULLSAFE_OBJECT_OPERATOR PropertyName  <?  return new Expr\NullsafePropertyFetch($_0, $_2);  ?>

# simple_variable
SimpleVariable
    = "$" "{" Expr "}"  <?  return new Expr\Variable($_2);  ?>
    | "$" SimpleVariable  <?  return new Expr\Variable($_1);  ?>
    | "$" Error  <?  return new Expr\Variable(new Expr\Error());  ?>
    | PlainVariable

# static_member_prop_name
StaticMemberPropName
    = SimpleVariable  <?  return \is_string($var) ? new Node\VarLikeIdentifier($var) : $var;  ?>

# static_member
StaticMember
    = ClassNameOrVar T_PAAMAYIM_NEKUDOTAYIM StaticMemberPropName  <?  return new Expr\StaticPropertyFetch($_0, $_2);  ?>

# new_variable
NewVariable
    = SimpleVariable
    | ClassName T_PAAMAYIM_NEKUDOTAYIM StaticMemberPropName  <?  return new Expr\StaticPropertyFetch($_0, $_2);  ?>
    | NewVariable "[" OptionalExpr "]"  <?  return new Expr\ArrayDimFetch($_0, $_2);  ?>
    | NewVariable "{" Expr "}"  <?  return new Expr\ArrayDimFetch($_0, $_2);  ?>
    | NewVariable T_OBJECT_OPERATOR PropertyName  <?  return new Expr\PropertyFetch($_0, $_2);  ?>
    | NewVariable T_NULLSAFE_OBJECT_OPERATOR PropertyName  <?  return new Expr\NullsafePropertyFetch($_0, $_2);  ?>
    | NewVariable T_PAAMAYIM_NEKUDOTAYIM StaticMemberPropName  <?  return new Expr\StaticPropertyFetch($_0, $_2);  ?>

# member_name
MemberName
    = "{" Expr "}"  <?  return $_1;  ?>
    | IdentifierMaybeReserved
    | SimpleVariable

# property_name
PropertyName
    = "{" Expr "}"  <?  return $_1;  ?>
    | IdentifierNotReserved
    | SimpleVariable

# list_expr
ListExpr
    = T_LIST "(" InnerArrayPairList ")"  <?  return new Expr\List_($_2);  ?>

# array_pair_list
ArrayPairList
    = InnerArrayPairList  <?  return $_0;  ?>

# comma_or_error
CommaOrError
    = ","

# inner_array_pair_list
InnerArrayPairList
    = InnerArrayPairList CommaOrError ArrayPair  <?  return $this->push($_0, $_2);  ?>
    | ArrayPair  <?  return $this->init($_0);  ?>

# array_pair
ArrayPair
    = T_ELLIPSIS Expr  <?  return new Node\ArrayItem($_1, null, false, $this->attributes(), true);  ?>
    | Expr T_DOUBLE_ARROW Expr  <?  return new Node\ArrayItem($_2, $_0,   false);  ?>
    | Expr T_DOUBLE_ARROW Ampersand Variable  <?  return new Node\ArrayItem($_3, $_0,   true);  ?>
    | Expr T_DOUBLE_ARROW ListExpr  <?  return new Node\ArrayItem($_2, $_0,   false);  ?>
    | Expr  <?  return new Node\ArrayItem($_0, null, false);  ?>
    | Ampersand Variable  <?  return new Node\ArrayItem($_1, null, true);  ?>
    | ListExpr  <?  return new Node\ArrayItem($_0, null, false);  ?>
    | ""  <?  return new Node\ArrayItem(new Expr\Error($attrs), null, false, $attrs);  ?>

# encaps_list
EncapsList
    = EncapsList EncapsVar  <?  return $this->push($_0, $_1);  ?>
    | EncapsList EncapsStringPart  <?  return $this->push($_0, $_1);  ?>
    | EncapsVar  <?  return $this->init($_0);  ?>
    | EncapsStringPart EncapsVar  <?  return $this->init($_0, $_1);  ?>

# encaps_string_part
EncapsStringPart
    = T_ENCAPSED_AND_WHITESPACE  <?  return new Node\InterpolatedStringPart($_0, $attrs);  ?>

# encaps_str_varname
EncapsStrVarname
    = T_STRING_VARNAME  <?  return new Expr\Variable($_0);  ?>

# encaps_var
EncapsVar
    = T_DOLLAR_OPEN_CURLY_BRACES Expr "}"  <?  return new Expr\Variable($_1);  ?>
    | T_DOLLAR_OPEN_CURLY_BRACES T_STRING_VARNAME "}"  <?  return new Expr\Variable($_1);  ?>
    | T_DOLLAR_OPEN_CURLY_BRACES EncapsStrVarname "[" Expr "]" "}"  <?  return new Expr\ArrayDimFetch($_1, $_3);  ?>
    | T_CURLY_OPEN Variable "}"  <?  return $_1;  ?>
    | PlainVariable "[" EncapsVarOffset "]"  <?  return new Expr\ArrayDimFetch($_0, $_2);  ?>
    | PlainVariable T_OBJECT_OPERATOR IdentifierNotReserved  <?  return new Expr\PropertyFetch($_0, $_2);  ?>
    | PlainVariable T_NULLSAFE_OBJECT_OPERATOR IdentifierNotReserved  <?  return new Expr\NullsafePropertyFetch($_0, $_2);  ?>
    | PlainVariable

# encaps_var_offset
EncapsVarOffset
    = T_STRING  <?  return new Scalar\String_($_0);  ?>
    | T_NUM_STRING  <?  return $this->parseNumString($_0, $this->attributes());  ?>
    | "-" T_NUM_STRING  <?  return $this->parseNumString('-' . $_1, $this->attributes());  ?>
    | PlainVariable

