# JSON Parser Grammar
# Produces native PHP values (arrays, objects, strings, numbers, booleans, null)

JSON "JSON value"
    = _ value:Value _ $  <? return $value; ?>

Value "value"
    = Object
    | Array
    | String
    | Number
    | True
    | False
    | Null

Object "object"
    = "{" _ "}"                      <? return new \stdClass(); ?>
    | "{" @ _ pairs:Pairs _ "}"        <? return (object)$pairs; ?>

Pairs "string"
    = result:Pair @ rest:(_ "," _ p:Pair)*  <?
        foreach ($rest as $r) {
            foreach ($r['p'] as $k => $v) {
                $result[$k] = $v;
            }
        }
        return $result;
    ?>

Pair "string"
    = key:String @ _ ":" _ value:Value  <? return [$key => $value]; ?>

Array "array"
    = "[" _ "]"                       <? return []; ?>
    | "[" _ items:Items _ "]"         <? return $items; ?>

Items "value"
    = first:Value @ rest:(_ "," _ v:Value)*  <?
        $result = [$first];
        foreach ($rest as $r) {
            $result[] = $r['v'];
        }
        return $result;
    ?>

String "string"
    = /"([^"\\]|\\["\\\/bfnrt]|\\u[0-9a-fA-F]{4})*"/  <?
        $s = \substr($_0, 1, -1);
        if (\strpos($s, '\\') === false) return $s;  # Fast path: no escapes
        $s = \strtr($s, ['\\\\' => "\x00", '\\"' => '"', '\\/' => '/',
            '\\b' => "\x08", '\\f' => "\x0c", '\\n' => "\n", '\\r' => "\r", '\\t' => "\t"]);
        return \preg_replace_callback('/\\\\u([0-9a-fA-F]{4})/', fn($m) =>
            (($cp = \hexdec($m[1])) < 0x80 ? \chr($cp) :
            ($cp < 0x800 ? \chr(0xC0 | $cp >> 6) . \chr(0x80 | $cp & 0x3F) :
            \chr(0xE0 | $cp >> 12) . \chr(0x80 | $cp >> 6 & 0x3F) . \chr(0x80 | $cp & 0x3F))),
            \str_replace("\x00", '\\', $s));
    ?>

Number "number"
    = /-?(0|[1-9][0-9]*)(\.[0-9]+)?([eE][+-]?[0-9]+)?/  <?
        return \strpos($_0, '.') !== false || \stripos($_0, 'e') !== false
            ? (float)$_0
            : (int)$_0;
    ?>

True "true"
    = "true"   <? return true; ?>

False "false"
    = "false"  <? return false; ?>

Null "null"
    = "null"   <? return null; ?>

_ "whitespace"
    = /[ \t\n\r]*/
